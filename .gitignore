# Margin keeps all personal data outside this folder (~/Library/Application Support/Margin).
# These are here in case a copy ever lands in the repo by mistake; the leak guard (margin privacy-check) blocks
# them too.
*.db
*.db-*
*.sqlite
*.sqlite3
*.pdf
*.csv
*.eml
*.mbox
*.p12
*.pem
*.key
statements/
settings.json
!/.claude/settings.json
rules.json
server.json
private-words.txt
client_secret*.json
.env
.env.*

# Images and videos only from `margin demo`, in docs/media/
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
*.mov
*.mp4
*.m4v
*.webm
!docs/media/**

# The website's demo pages: made by `margin demo --export`, here to look at and on GitHub when the site is published
# (.github/workflows/website.yml). Never committed: their invented numbers can equal your real ones by chance, and
# the leak guard rightly refuses those.
docs/demo/

__pycache__/
.DS_Store
.claude/settings.local.json
