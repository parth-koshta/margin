{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "./margin-cli",
      "runtimeArgs": ["demo", "--no-open"],
      "port": 8765,
      "url": "http://demo.margin.localhost:8765"
    },
    {
      "name": "demo-india",
      "runtimeExecutable": "./margin-cli",
      "runtimeArgs": ["demo", "--india", "--no-open", "--port", "8767"],
      "port": 8767,
      "url": "http://demo.margin.localhost:8767"
    },
    {
      "name": "site",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": ["-m", "http.server", "8779", "--bind", "127.0.0.1", "--directory", "docs"],
      "port": 8779
    }
  ]
}
